# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

# Go workspace file
go.work
go.work.sum

# Environment files
.env
.env.local
.env.production
.idea/

# Logs and temporary files
**/logs/
*.log
**/export/

# Editor files
.vscode/
.DS_Store
**/__debug_bin*

# Build artifacts
main
auth-service
dist/
build/

# Documentation drafts (keep organized structure)
# Only ignore temporary draft files, not organized docs
doc/draft-*
doc/temp-*

# Database files
*.db
*.sqlite
*.sqlite3

# Coverage reports
coverage.html
coverage.out

# Go module cache
.sum